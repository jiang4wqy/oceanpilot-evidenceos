# OceanPilot EvidenceOS — 环境变量样例 / environment variable reference
#
# 复制为 .env（已在 .gitignore 中）并按需填写；也可直接 export 到进程环境。
# 应用通过 Settings.from_env()（src/oceanpilot/config.py）读取这些变量。
#
# 安全红线：绝不把真实密钥 / token 提交进仓库。凭据只经环境变量注入。
# 未配置对应变量时，相关能力优雅降级（见每项说明），核心链路仍可离线运行。

# ---------------------------------------------------------------------------
# 存储 / Storage（SQLite 文件路径）
# ---------------------------------------------------------------------------
# 基础案件库（缺省 work/oceanpilot.db）。
OCEANPILOT_DB_PATH=work/oceanpilot.db
# 拒付案件库；缺省为 db_path 同目录下的 oceanpilot-chargeback.db。
# OCEANPILOT_CHARGEBACK_DB_PATH=work/oceanpilot-chargeback.db
# 飞书回调库；缺省为 db_path 同目录下的 oceanpilot-feishu.db。
# OCEANPILOT_FEISHU_DB_PATH=work/oceanpilot-feishu.db

# ---------------------------------------------------------------------------
# 双端控制台 / Two-console local setup
# ---------------------------------------------------------------------------
# 客户端允许维护端执行只读跨域监控查询。
# OCEANPILOT_ADMIN_ORIGIN=http://127.0.0.1:8003
# 维护端从这个地址读取客户服务监控接口。
# OCEANPILOT_CLIENT_BASE_URL=http://127.0.0.1:8002

# ---------------------------------------------------------------------------
# 模型层 / Model layer（全部可选：都不配置则使用离线合成 provider）
# ---------------------------------------------------------------------------
# 正式 Web 演示只使用 DeepSeek；离线模式不需要密钥。
# OCEANPILOT_MODEL_PROVIDER=deepseek
#
# DeepSeek（OpenAI-compatible Chat Completions）。密钥只写入本机 .env。
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# Claude（LOW/MEDIUM 档）。未设置则拒付集群不会走真实模型。
# ANTHROPIC_API_KEY=sk-ant-...
#
# V1 拒付集群与 V2 案件智能体“启用真实模型”的显式开关（1/true/yes/on）。
# 缺省关闭：即使设置了外部模型密钥，测试/CI 仍保持确定性离线。
# V2 启用后：关键案件事件后台解读、案件对话调用 DeepSeek；工具观察仍即时完成。
# 用 uvicorn --env-file .env 加载本机配置；不要把密钥提交至 Git。
# OCEANPILOT_CHARGEBACK_LIVE_MODEL=0
# 默认关闭最终发送。冻结版本、失效、幂等与重启恢复未全部验收前不得启用。
# 当前即使设为 1，发送仍返回 MOCK_SEND_NOT_READY；只开放只读预览及复核摘要。
# OCEANPILOT_MOCK_SEND_ENABLED=0
#
# 本地隔离模型（HIGH 档，OpenAI 兼容 /v1/chat/completions）。三者需配套。
# OCEANPILOT_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# OCEANPILOT_LOCAL_MODEL_NAME=qwen2.5-7b-instruct
# OCEANPILOT_LOCAL_MODEL_API_KEY=

# ---------------------------------------------------------------------------
# 飞书渠道 / Feishu channel（可选；四项齐备才启用，否则相关路由返回安全 503）
# ---------------------------------------------------------------------------
# 切勿提交真实值：App Secret / verification token / encrypt key 均为敏感凭据。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# OceanPilot V2 synthetic competition runtime. Never a production submission mode.
OCEANPILOT_V2_UPSTREAM_MODE=mock
OCEANPILOT_V2_BASE_URL=http://127.0.0.1:8002
# Trusted Feishu identity/chat bindings; see docs/v2/feishu.md. Empty disables V2 callbacks.
OCEANPILOT_V2_FEISHU_BINDINGS_JSON=
