# OceanPilot 统一配置：修改后运行 restart.sh / restart.bat 生效。
# 首次 start 会复制为 config.env 并替换随机密码占位符。

# 数据库：postgresql（默认）或 sqlite。切换 SQLite 时同时留空 COMPOSE_PROFILES。
COMPOSE_PROFILES=postgresql
OCEANPILOT_DATABASE_BACKEND=postgresql
OCEANPILOT_POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
OCEANPILOT_DATABASE_URL=postgresql+psycopg://oceanpilot:__POSTGRES_PASSWORD__@postgres:5432/oceanpilot

OCEANPILOT_HOST_PORT=8000
OCEANPILOT_PUBLIC_BASE_URL=http://localhost:8000
OCEANPILOT_ADMIN_ORIGIN=http://localhost:8000
OCEANPILOT_CLIENT_BASE_URL=http://localhost:8000
OCEANPILOT_V21_SECURE_COOKIES=0

# 模型：offline / deepseek / claude / openai_compatible。
OCEANPILOT_MODEL_PROVIDER=offline
OCEANPILOT_CHARGEBACK_LIVE_MODEL=0
OCEANPILOT_MODEL_BASE_URL=
OCEANPILOT_MODEL_API_KEY=
OCEANPILOT_MODEL_NAME=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

# 上游仅允许 mock 或 disabled。
OCEANPILOT_V2_UPSTREAM_MODE=mock
OCEANPILOT_MOCK_SEND_ENABLED=0

# 飞书（全部留空即关闭）。
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
OCEANPILOT_FEISHU_PUBLIC_KNOWLEDGE_PATH=
OCEANPILOT_FEISHU_PUBLIC_GROUPS_JSON={"groups":[]}
OCEANPILOT_FEISHU_PUBLIC_OUTBOUND=disabled
OCEANPILOT_FEISHU_PRIVATE_CASES=disabled
OCEANPILOT_FEISHU_PRIVATE_OUTBOUND=disabled
OCEANPILOT_V2_FEISHU_BINDINGS_JSON=
